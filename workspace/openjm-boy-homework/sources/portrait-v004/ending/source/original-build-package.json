{
  "name": "openjm-dashboard-loader-video",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../scripts/build.mjs",
    "check": "hyperframes check . --strict",
    "preview": "hyperframes preview . --port 3316 --background",
    "render": "hyperframes render . --output ../output/dashboard-loader-16x9.mp4 --fps 60 --quality delivery --workers 2 --strict --no-best-effort"
  },
  "dependencies": {
    "hyperframes": "0.8.143",
    "three": "0.186.1",
    "gsap": "3.14.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.25.11"
  }
}
